          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  (floor((end_battery_level - start_battery_level) / 10) * 10)::int AS \"SOC Added\",\n  count(*) AS \"Charges\"\nFROM charging_processes\nWHERE car_id = $car_id AND $__timeFilter(start_date) AND end_date IS NOT NULL\n  AND start_battery_level IS NOT NULL AND end_battery_level IS NOT NULL\nGROUP BY 1\nORDER BY 1;",
