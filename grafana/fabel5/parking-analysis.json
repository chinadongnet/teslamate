          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH parked AS (\n  SELECT\n    end_address_id,\n    end_date,\n    LEAD(start_date) OVER (ORDER BY start_date) AS next_start\n  FROM drives\n  WHERE car_id = $car_id AND end_date IS NOT NULL\n),\nagg AS (\n  SELECT\n    COALESCE(a.name, a.display_name, 'Unknown') AS loc,\n    sum(date_part('epoch', next_start - end_date)) AS sec\n  FROM parked\n  LEFT JOIN addresses a ON parked.end_address_id = a.id\n  WHERE next_start IS NOT NULL AND $__timeFilter(end_date)\n  GROUP BY 1\n)\nSELECT 100.0 * max(sec) / NULLIF(sum(sec), 0) AS \"Top Location\"\nFROM agg;",
          "refId": "A"
        }
      ],
      "title": "Time at Top Location",
      "type": "stat"
