      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "TeslaMate"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  TIMEZONE('$__timezone', TIMEZONE('UTC', start_date)) AS \"Start\",\n  COALESCE(sa.name, sa.display_name, '?') AS \"From\",\n  COALESCE(ea.name, ea.display_name, '?') AS \"To\",\n  convert_km(start_km::numeric, '$length_unit') AS \"Odo Start\",\n  convert_km(end_km::numeric, '$length_unit') AS \"Odo End\",\n  convert_km(distance::numeric, '$length_unit') AS \"Distance\",\n  duration_min AS \"Duration\",\n  convert_km((distance / NULLIF(duration_min / 60.0, 0))::numeric, '$length_unit') AS \"Ø Speed\",\n  convert_km(speed_max::numeric, '$length_unit') AS \"Max Speed\",\n  100 * (start_${preferred_range}_range_km - end_${preferred_range}_range_km) * cars.efficiency / NULLIF(convert_km(distance::numeric, '$length_unit'), 0) AS \"kWh/100\",\n  convert_celsius(outside_temp_avg, '$temp_unit') AS \"Ø Temp\"\nFROM drives\nINNER JOIN cars ON drives.car_id = cars.id\nLEFT JOIN addresses sa ON drives.start_address_id = sa.id\nLEFT JOIN addresses ea ON drives.end_address_id = ea.id\nWHERE drives.car_id = $car_id AND $__timeFilter(start_date)\n  AND end_date IS NOT NULL\nORDER BY start_date DESC\nLIMIT 500;",
          "refId": "A"
        }
      ],
      "title": "Drive Log",
      "type": "table"
    }
