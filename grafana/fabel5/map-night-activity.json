      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "TeslaMate"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT latitude, longitude\nFROM positions\nWHERE car_id = $car_id AND $__timeFilter(date)\n  AND ideal_battery_range_km IS NOT NULL AND mod(id, 2) = 0\n  AND (date_part('hour', TIMEZONE('$__timezone', TIMEZONE('UTC', date))) >= 22 OR date_part('hour', TIMEZONE('$__timezone', TIMEZONE('UTC', date))) < 6);",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "TeslaMate"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  COALESCE(a.name, a.display_name, '?') AS \"Destination\",\n  a.latitude AS latitude,\n  a.longitude AS longitude,\n  count(*) AS \"Night Arrivals\"\nFROM drives d\nJOIN addresses a ON d.end_address_id = a.id\nWHERE d.car_id = $car_id AND $__timeFilter(d.start_date)\n  AND d.end_date IS NOT NULL AND (date_part('hour', TIMEZONE('$__timezone', TIMEZONE('UTC', start_date))) >= 22 OR date_part('hour', TIMEZONE('$__timezone', TIMEZONE('UTC', start_date))) < 6)\nGROUP BY 1, 2, 3;",
          "refId": "B"
        }
      ],
      "title": "Night Driving (22:00 – 06:00)",
