      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "TeslaMate"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  COALESCE(g.name, a.name, a.display_name, 'Unknown') AS \"Location\",\n  avg(p.latitude) AS latitude,\n  avg(p.longitude) AS longitude,\n  count(*) AS \"Charges\",\n  sum(cp.charge_energy_added) AS \"Energy\",\n  sum(cp.cost) / NULLIF(sum(cp.charge_energy_added), 0) AS \"Cost per kWh\"\nFROM charging_processes cp\nLEFT JOIN positions p ON cp.position_id = p.id\nLEFT JOIN addresses a ON cp.address_id = a.id\nLEFT JOIN geofences g ON cp.geofence_id = g.id\nWHERE cp.car_id = $car_id AND $__timeFilter(cp.start_date)\n  AND cp.end_date IS NOT NULL\nGROUP BY 1\nHAVING avg(p.latitude) IS NOT NULL;",
          "refId": "A"
        }
      ],
      "title": "Charging Locations (size = energy, color = cost per kWh)",
      "type": "geomap"
