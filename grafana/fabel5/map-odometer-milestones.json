          "rawQuery": true,
          "rawSql": "WITH milestones AS (\n  SELECT\n    (floor(convert_km(odometer::numeric, '$length_unit') / 5000) * 5000)::int AS milestone,\n    date,\n    row_number() OVER (\n      PARTITION BY floor(convert_km(odometer::numeric, '$length_unit') / 5000)\n      ORDER BY date) AS rn\n  FROM positions\n  WHERE car_id = $car_id AND odometer IS NOT NULL AND ideal_battery_range_km IS NOT NULL\n)\nSELECT\n  milestone AS \"Milestone ($length_unit)\",\n  TIMEZONE('$__timezone', TIMEZONE('UTC', date)) AS \"Reached\"\nFROM milestones\nWHERE rn = 1 AND milestone > 0\nORDER BY milestone DESC\nLIMIT 10;",
          "refId": "A"
        }
      ],
