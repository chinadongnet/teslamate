          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH t AS (\n  SELECT\n    extract(year FROM TIMEZONE('$__timezone', TIMEZONE('UTC', start_date)))::int AS yr,\n    extract(doy FROM TIMEZONE('$__timezone', TIMEZONE('UTC', start_date)))::int AS doy,\n    distance\n  FROM drives\n  WHERE car_id = $car_id AND end_date IS NOT NULL\n),\nnow_doy AS (\n  SELECT extract(doy FROM TIMEZONE('$__timezone', now()))::int AS doy,\n         extract(year FROM TIMEZONE('$__timezone', now()))::int AS yr\n)\nSELECT\n  100.0 * sum(distance) FILTER (WHERE t.yr = n.yr AND t.doy <= n.doy)\n        / NULLIF(sum(distance) FILTER (WHERE t.yr = n.yr - 1 AND t.doy <= n.doy), 0)\n  - 100 AS \"vs Last Year\"\nFROM t, now_doy n;",
          "refId": "A"
        }
      ],
      "title": "Distance YTD vs Last Year Same Date",
      "type": "stat"
    },
