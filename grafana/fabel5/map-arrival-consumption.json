          "rawQuery": true,
          "rawSql": "SELECT\n  COALESCE(a.name, a.display_name, '?') AS \"Destination\",\n  count(*) AS \"Drives\",\n  100 * sum((start_${preferred_range}_range_km - end_${preferred_range}_range_km) * cars.efficiency)\n      / NULLIF(sum(convert_km(distance::numeric, '$length_unit')), 0) AS \"kWh/100\"\nFROM drives\nINNER JOIN cars ON drives.car_id = cars.id\nJOIN addresses a ON drives.end_address_id = a.id\nWHERE drives.car_id = $car_id AND $__timeFilter(start_date)\n  AND end_date IS NOT NULL AND distance > 3 AND duration_min >= 5\nGROUP BY 1\nHAVING count(*) >= 3 AND sum((start_${preferred_range}_range_km - end_${preferred_range}_range_km) * cars.efficiency) > 0\nORDER BY 3 DESC\nLIMIT 10;",
          "refId": "A"
        }
