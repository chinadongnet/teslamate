          "rawSql": "SELECT\n  $__timeGroup(date, $__interval),\n  avg(convert_tire_pressure(tpms_pressure_fl, '$pressure_unit')) AS \"Front Left\",\n  avg(convert_tire_pressure(tpms_pressure_fr, '$pressure_unit')) AS \"Front Right\",\n  avg(convert_tire_pressure(tpms_pressure_rl, '$pressure_unit')) AS \"Rear Left\",\n  avg(convert_tire_pressure(tpms_pressure_rr, '$pressure_unit')) AS \"Rear Right\"\nFROM positions\nWHERE car_id = $car_id AND $__timeFilter(date) AND tpms_pressure_fl IS NOT NULL\nGROUP BY 1\nORDER BY 1;",
