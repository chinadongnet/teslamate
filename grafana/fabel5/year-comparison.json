      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "TeslaMate"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  extract(year FROM TIMEZONE('$__timezone', TIMEZONE('UTC', start_date)))::int AS \"Year\",\n  count(*) AS \"Drives\",\n  convert_km(sum(distance)::numeric, '$length_unit') AS \"Distance\",\n  sum(duration_min) / 60.0 AS \"Hours Driven\",\n  (SELECT count(*) FROM charging_processes cp\n    WHERE cp.car_id = $car_id AND cp.end_date IS NOT NULL\n      AND extract(year FROM TIMEZONE('$__timezone', TIMEZONE('UTC', cp.start_date)))\n        = extract(year FROM TIMEZONE('$__timezone', TIMEZONE('UTC', start_date)))) AS \"Charges\",\n  (SELECT sum(charge_energy_added) FROM charging_processes cp\n    WHERE cp.car_id = $car_id AND cp.end_date IS NOT NULL\n      AND extract(year FROM TIMEZONE('$__timezone', TIMEZONE('UTC', cp.start_date)))\n        = extract(year FROM TIMEZONE('$__timezone', TIMEZONE('UTC', start_date)))) AS \"Energy Added\",\n  (SELECT sum(cost) FROM charging_processes cp\n    WHERE cp.car_id = $car_id AND cp.end_date IS NOT NULL\n      AND extract(year FROM TIMEZONE('$__timezone', TIMEZONE('UTC', cp.start_date)))\n        = extract(year FROM TIMEZONE('$__timezone', TIMEZONE('UTC', start_date)))) AS \"Charging Cost\"\nFROM drives\nWHERE car_id = $car_id AND end_date IS NOT NULL\nGROUP BY 1\nORDER BY 1 DESC;",
          "refId": "A"
        }
      ],
      "title": "Yearly Totals",
