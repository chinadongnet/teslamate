          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH sessions AS (\n  SELECT\n    cp.id,\n    cp.start_date,\n    cp.address_id,\n    cp.geofence_id,\n    cp.start_battery_level,\n    cp.end_battery_level,\n    cp.charge_energy_added,\n    cp.charge_energy_used,\n    cp.duration_min,\n    cp.cost,\n    CASE WHEN NULLIF(mode() WITHIN GROUP (ORDER BY c.charger_phases), 0) IS NULL\n         THEN 'DC' ELSE 'AC' END AS current,\n    max(c.charger_power) AS max_power\n  FROM charging_processes cp\n  JOIN charges c ON cp.id = c.charging_process_id\n  WHERE cp.car_id = $car_id AND $__timeFilter(cp.start_date)\n    AND cp.end_date IS NOT NULL\n  GROUP BY 1\n)\nSELECT count(*) AS \"Sessions\" FROM sessions;",
          "refId": "A"
        }
      ],
      "title": "Sessions",
      "type": "stat"
    },
