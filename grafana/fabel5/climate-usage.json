          "rawQuery": true,
          "rawSql": "SELECT\n  $__timeGroup(date, $__interval),\n  avg(convert_celsius(inside_temp, '$temp_unit')) AS \"Inside\",\n  avg(convert_celsius(outside_temp, '$temp_unit')) AS \"Outside\"\nFROM positions\nWHERE car_id = $car_id AND $__timeFilter(date)\n  AND ideal_battery_range_km IS NOT NULL\n  AND (inside_temp IS NOT NULL OR outside_temp IS NOT NULL)\nGROUP BY 1\nORDER BY 1;",
