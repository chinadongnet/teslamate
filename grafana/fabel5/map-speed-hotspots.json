          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT DISTINCT ON (drive_id)\n  latitude, longitude,\n  convert_km(speed::numeric, '$length_unit') AS \"Top Speed\"\nFROM positions\nWHERE car_id = $car_id AND $__timeFilter(date)\n  AND drive_id IS NOT NULL AND speed IS NOT NULL\nORDER BY drive_id, speed DESC\nLIMIT 300;",
