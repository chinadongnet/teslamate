      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "TeslaMate"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH versions AS (\n  SELECT\n    split_part(version, ' ', 1) AS version,\n    start_date,\n    COALESCE(LEAD(start_date) OVER (ORDER BY start_date),\n             TIMEZONE('UTC', now())) AS next_date\n  FROM updates\n  WHERE car_id = $car_id AND end_date IS NOT NULL AND version IS NOT NULL\n)\nSELECT\n  v.version AS \"Version\",\n  TIMEZONE('$__timezone', TIMEZONE('UTC', v.start_date)) AS \"Installed\",\n  round(date_part('epoch', v.next_date - v.start_date) / 86400) AS \"Days\",\n  count(drives.id) AS \"Drives\",\n  convert_km(sum(distance)::numeric, '$length_unit') AS \"Distance\",\n  100 * sum((start_${preferred_range}_range_km - end_${preferred_range}_range_km) * cars.efficiency) / NULLIF(sum(convert_km(distance::numeric, '$length_unit')), 0) AS \"kWh/100\"\nFROM versions v\nLEFT JOIN drives ON drives.start_date >= v.start_date\n                AND drives.start_date < v.next_date\n                AND drives.car_id = $car_id\n                AND drives.end_date IS NOT NULL\n                AND distance > 1 AND duration_min >= 2\nLEFT JOIN cars ON cars.id = $car_id\nGROUP BY v.version, v.start_date, v.next_date\nORDER BY v.start_date DESC;",
          "refId": "A"
        }
      ],
      "title": "Firmware History & Stats",
      "type": "table"
