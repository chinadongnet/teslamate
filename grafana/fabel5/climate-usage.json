          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  to_char(date_trunc('month', TIMEZONE('$__timezone', TIMEZONE('UTC', date))), 'YYYY-MM') AS \"Month\",\n  100.0 * count(*) FILTER (WHERE is_climate_on) / NULLIF(count(*), 0) AS \"Climate On [%]\",\n  avg(convert_celsius(outside_temp, '$temp_unit')) AS \"Ø Outside [°$temp_unit]\"\nFROM positions\nWHERE car_id = $car_id AND $__timeFilter(date) AND ideal_battery_range_km IS NOT NULL\nGROUP BY 1\nORDER BY 1;",
          "refId": "A"
        }
      ],
