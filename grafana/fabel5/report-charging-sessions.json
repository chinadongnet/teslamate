          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "TeslaMate"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH sessions AS (\n  SELECT\n    cp.id,\n    cp.start_date,\n    cp.address_id,\n    cp.geofence_id,\n    cp.start_battery_level,\n    cp.end_battery_level,\n    cp.charge_energy_added,\n    cp.charge_energy_used,\n    cp.duration_min,\n    cp.cost,\n    CASE WHEN NULLIF(mode() WITHIN GROUP (ORDER BY c.charger_phases), 0) IS NULL\n         THEN 'DC' ELSE 'AC' END AS current,\n    max(c.charger_power) AS max_power\n  FROM charging_processes cp\n  JOIN charges c ON cp.id = c.charging_process_id\n  WHERE cp.car_id = $car_id AND $__timeFilter(cp.start_date)\n    AND cp.end_date IS NOT NULL\n  GROUP BY 1\n)\nSELECT\n  TIMEZONE('$__timezone', TIMEZONE('UTC', s.start_date)) AS \"Start\",\n  COALESCE(g.name, a.name, a.display_name, 'Unknown') AS \"Location\",\n  s.current AS \"Type\",\n  s.start_battery_level AS \"SOC From\",\n  s.end_battery_level AS \"SOC To\",\n  s.charge_energy_added AS \"Added\",\n  s.charge_energy_used AS \"Used\",\n  s.max_power AS \"Peak Power\",\n  s.duration_min AS \"Duration\",\n  s.cost AS \"Cost\",\n  s.cost / NULLIF(s.charge_energy_added, 0) AS \"Cost per kWh\"\nFROM sessions s\nLEFT JOIN addresses a ON s.address_id = a.id\nLEFT JOIN geofences g ON s.geofence_id = g.id\nORDER BY s.start_date DESC\nLIMIT 500;",
          "refId": "A"
        }
      ],
      "title": "All Charging Sessions",
      "type": "table"
    }
