            "type": "grafana-postgresql-datasource",
            "uid": "TeslaMate"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  TIMEZONE('$__timezone', TIMEZONE('UTC', d.start_date)) AS \"Start\",\n  COALESCE(sa.name, sa.display_name, '?') AS \"From\",\n  convert_km(d.distance::numeric, '$length_unit') AS \"Distance\"\nFROM drives d\nLEFT JOIN addresses sa ON d.start_address_id = sa.id\nWHERE d.car_id = $car_id AND $__timeFilter(d.start_date) AND d.end_date IS NULL\nORDER BY d.start_date DESC\nLIMIT 15;",
          "refId": "A"
        }
      ],
