      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "TeslaMate"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH data AS (\n  SELECT\n    floor(convert_celsius(outside_temp_avg, '$temp_unit') / 5) * 5 AS temp_band,\n    distance,\n    (start_rated_range_km - end_rated_range_km) AS range_used\n  FROM drives\n  WHERE car_id = $car_id AND $__timeFilter(start_date) AND end_date IS NOT NULL AND distance > 1 AND (start_rated_range_km - end_rated_range_km) > 0.5 AND outside_temp_avg IS NOT NULL\n)\nSELECT\n  temp_band::int AS \"Temp\",\n  100.0 * sum(distance) / NULLIF(sum(range_used), 0) AS \"Achievement\",\n  count(*) AS \"Drives\"\nFROM data\nGROUP BY 1\nHAVING count(*) >= 3\nORDER BY 1;",
          "refId": "A"
        }
      ],
      "title": "Range Achievement by Temperature Band (°$temp_unit)",
      "type": "barchart"
    }
