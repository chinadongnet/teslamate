          "rawQuery": true,
          "rawSql": "SELECT\n  convert_tire_pressure(tpms_pressure_fl, '$pressure_unit') AS \"Front Left\",\n  convert_tire_pressure(tpms_pressure_fr, '$pressure_unit') AS \"Front Right\",\n  convert_tire_pressure(tpms_pressure_rl, '$pressure_unit') AS \"Rear Left\",\n  convert_tire_pressure(tpms_pressure_rr, '$pressure_unit') AS \"Rear Right\"\nFROM positions\nWHERE car_id = $car_id AND tpms_pressure_fl IS NOT NULL\nORDER BY date DESC\nLIMIT 1;",
