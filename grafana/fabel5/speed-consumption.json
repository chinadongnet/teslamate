      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "TeslaMate"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  TIMEZONE('$__timezone', TIMEZONE('UTC', start_date)) AS \"Start\",\n  COALESCE(sa.name, sa.display_name, '?') AS \"From\",\n  COALESCE(ea.name, ea.display_name, '?') AS \"To\",\n  convert_km(distance::numeric, '$length_unit') AS \"Distance\",\n  convert_km((distance / (duration_min / 60.0))::numeric, '$length_unit') AS \"Ø Speed\",\n  100 * (start_${preferred_range}_range_km - end_${preferred_range}_range_km) * cars.efficiency / NULLIF(convert_km(distance::numeric, '$length_unit'), 0) AS \"kWh/100\"\nFROM drives\nINNER JOIN cars ON drives.car_id = cars.id\nLEFT JOIN addresses sa ON drives.start_address_id = sa.id\nLEFT JOIN addresses ea ON drives.end_address_id = ea.id\nWHERE drives.car_id = $car_id AND $__timeFilter(start_date) AND end_date IS NOT NULL AND distance > 1 AND duration_min >= 2 AND distance > 5 AND (start_${preferred_range}_range_km - end_${preferred_range}_range_km) * cars.efficiency > 0\nORDER BY 6 DESC NULLS LAST\nLIMIT 10;",
          "refId": "A"
        }
      ],
      "title": "Least Efficient Drives",
      "type": "table"
    }
