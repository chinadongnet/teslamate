          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  extract(year FROM TIMEZONE('$__timezone', TIMEZONE('UTC', start_date)))::int AS \"Year\",\n  count(DISTINCT end_address_id) AS \"Distinct Places\",\n  count(*) AS \"Arrivals\"\nFROM drives\nWHERE car_id = $car_id AND $__timeFilter(start_date)\n  AND end_date IS NOT NULL AND end_address_id IS NOT NULL\nGROUP BY 1\nORDER BY 1 DESC;",
          "refId": "A"
        }
      ],
      "title": "Places per Year",
