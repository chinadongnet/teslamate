          "rawQuery": true,
          "rawSql": "WITH daily AS (\n  SELECT\n    extract(year FROM TIMEZONE('$__timezone', TIMEZONE('UTC', start_date)))::int AS yr,\n    extract(doy FROM TIMEZONE('$__timezone', TIMEZONE('UTC', start_date)))::int AS doy,\n    sum(cost) AS cost\n  FROM charging_processes\n  WHERE car_id = $car_id AND end_date IS NOT NULL AND cost IS NOT NULL\n  GROUP BY 1, 2\n)\nSELECT\n  (date '2000-01-01' + (doy - 1))::timestamptz AS time,\n  yr::text AS metric,\n  sum(cost) OVER (PARTITION BY yr ORDER BY doy) AS \"Cost\"\nFROM daily\nORDER BY 1;",
          "refId": "A"
        }
      ],
