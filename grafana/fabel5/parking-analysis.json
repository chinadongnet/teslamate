          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  100.0 * (1.0 - COALESCE(sum(duration_min), 0)\n    / NULLIF(date_part('epoch', $__timeTo()::timestamptz - $__timeFrom()::timestamptz) / 60.0, 0)) AS \"Parked\"\nFROM drives\nWHERE car_id = $car_id AND $__timeFilter(start_date) AND end_date IS NOT NULL;",
          "refId": "A"
        }
      ],
      "title": "Parked Share of Time",
      "type": "stat"
