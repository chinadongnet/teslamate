          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  date_trunc('month', TIMEZONE('UTC', start_date), '$__timezone') AS time,\n  100.0 * sum(distance) / NULLIF(sum((start_rated_range_km - end_rated_range_km)), 0) AS \"Achievement [%]\",\n  avg(convert_celsius(outside_temp_avg, '$temp_unit')) AS \"Ø Outside [°$temp_unit]\"\nFROM drives\nWHERE car_id = $car_id AND $__timeFilter(start_date) AND end_date IS NOT NULL AND distance > 1 AND (start_rated_range_km - end_rated_range_km) > 0.5\nGROUP BY 1\nORDER BY 1;",
