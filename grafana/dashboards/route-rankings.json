      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "TeslaMate"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH drive_points AS (\n  SELECT\n    d.id AS drive_id,\n    d.car_id,\n    d.start_date,\n    d.end_date,\n    floor(extract(epoch FROM d.start_date)) * 1000 AS start_date_ts,\n    ceil(extract(epoch FROM d.end_date)) * 1000 AS end_date_ts,\n    d.duration_min,\n    d.distance,\n    d.speed_max,\n    d.distance / NULLIF(d.duration_min::numeric / 60, 0) AS avg_speed,\n    floor(sp.latitude::numeric / NULLIF('$route_bucket_degrees'::numeric, 0)) * '$route_bucket_degrees'::numeric AS start_lat_bucket,\n    floor(sp.longitude::numeric / NULLIF('$route_bucket_degrees'::numeric, 0)) * '$route_bucket_degrees'::numeric AS start_lon_bucket,\n    floor(ep.latitude::numeric / NULLIF('$route_bucket_degrees'::numeric, 0)) * '$route_bucket_degrees'::numeric AS end_lat_bucket,\n    floor(ep.longitude::numeric / NULLIF('$route_bucket_degrees'::numeric, 0)) * '$route_bucket_degrees'::numeric AS end_lon_bucket,\n    COALESCE(\n      sg.name,\n      CONCAT_WS(', ', COALESCE(sa.name, nullif(CONCAT_WS(' ', sa.road, sa.house_number), '')), sa.city),\n      CONCAT(round(sp.latitude::numeric, 5), ', ', round(sp.longitude::numeric, 5))\n    ) AS start_location,\n    COALESCE(\n      eg.name,\n      CONCAT_WS(', ', COALESCE(ea.name, nullif(CONCAT_WS(' ', ea.road, ea.house_number), '')), ea.city),\n      CONCAT(round(ep.latitude::numeric, 5), ', ', round(ep.longitude::numeric, 5))\n    ) AS end_location\n  FROM drives d\n  JOIN positions sp ON sp.id = d.start_position_id\n  JOIN positions ep ON ep.id = d.end_position_id\n  LEFT JOIN addresses sa ON sa.id = d.start_address_id\n  LEFT JOIN addresses ea ON ea.id = d.end_address_id\n  LEFT JOIN geofences sg ON sg.id = d.start_geofence_id\n  LEFT JOIN geofences eg ON eg.id = d.end_geofence_id\n  WHERE d.car_id = $car_id\n    AND $__timeFilter(d.start_date)\n    AND d.end_date IS NOT NULL\n    AND d.duration_min > 0\n    AND convert_km(d.distance::numeric, '$length_unit') >= NULLIF('$min_distance', '')::numeric\n    AND sp.latitude IS NOT NULL\n    AND sp.longitude IS NOT NULL\n    AND ep.latitude IS NOT NULL\n    AND ep.longitude IS NOT NULL\n),\nranked_points AS (\n  SELECT\n    drive_points.*,\n    row_number() OVER (\n      PARTITION BY start_lat_bucket, start_lon_bucket, end_lat_bucket, end_lon_bucket\n      ORDER BY avg_speed DESC NULLS LAST, duration_min ASC, start_date DESC\n    ) AS fastest_rank,\n    row_number() OVER (\n      PARTITION BY start_lat_bucket, start_lon_bucket, end_lat_bucket, end_lon_bucket\n      ORDER BY avg_speed ASC NULLS LAST, duration_min DESC, start_date DESC\n    ) AS slowest_rank\n  FROM drive_points\n),\nroute_groups AS (\n  SELECT\n    start_lat_bucket,\n    start_lon_bucket,\n    end_lat_bucket,\n    end_lon_bucket,\n    count(*) AS drive_count,\n    mode() WITHIN GROUP (ORDER BY start_location) AS start_location,\n    mode() WITHIN GROUP (ORDER BY end_location) AS end_location,\n    avg(distance) AS avg_distance,\n    max(start_date) AS latest_drive_at\n  FROM drive_points\n  GROUP BY 1, 2, 3, 4\n),\ntop_routes AS (\n  SELECT\n    row_number() OVER (ORDER BY drive_count DESC, latest_drive_at DESC) AS route_rank,\n    *\n  FROM route_groups\n  ORDER BY drive_count DESC, latest_drive_at DESC\n  LIMIT 10\n),\nfastest AS (\n  SELECT * FROM ranked_points WHERE fastest_rank = 1\n),\nslowest AS (\n  SELECT * FROM ranked_points WHERE slowest_rank = 1\n)\nSELECT\n  tr.route_rank,\n  tr.drive_count,\n  tr.start_location,\n  tr.end_location,\n  round(convert_km(tr.avg_distance::numeric, '$length_unit'), 1) AS avg_distance_$length_unit,\n  f.car_id,\n  f.drive_id AS fastest_drive_id,\n  f.start_date_ts AS fastest_start_ts,\n  f.end_date_ts AS fastest_end_ts,\n  f.start_date AS fastest_time,\n  f.duration_min AS fastest_duration_min,\n  round(convert_km(f.speed_max::numeric, '$length_unit'), 1) AS fastest_speed_max_$length_unit,\n  round(convert_km(f.avg_speed::numeric, '$length_unit'), 1) AS fastest_avg_speed_$length_unit,\n  s.drive_id AS slowest_drive_id,\n  s.start_date_ts AS slowest_start_ts,\n  s.end_date_ts AS slowest_end_ts,\n  s.start_date AS slowest_time,\n  s.duration_min AS slowest_duration_min,\n  round(convert_km(s.speed_max::numeric, '$length_unit'), 1) AS slowest_speed_max_$length_unit,\n  round(convert_km(s.avg_speed::numeric, '$length_unit'), 1) AS slowest_avg_speed_$length_unit\nFROM top_routes tr\nJOIN fastest f USING (start_lat_bucket, start_lon_bucket, end_lat_bucket, end_lon_bucket)\nJOIN slowest s USING (start_lat_bucket, start_lon_bucket, end_lat_bucket, end_lon_bucket)\nORDER BY tr.route_rank;",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "Top 10 route rankings",
      "type": "table"
    }
  ],
