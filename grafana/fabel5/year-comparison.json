          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH daily AS (\n  SELECT\n    extract(year FROM TIMEZONE('$__timezone', TIMEZONE('UTC', start_date)))::int AS yr,\n    extract(doy FROM TIMEZONE('$__timezone', TIMEZONE('UTC', start_date)))::int AS doy,\n    sum(convert_km(distance::numeric, '$length_unit')) AS dist\n  FROM drives\n  WHERE car_id = $car_id AND end_date IS NOT NULL\n  GROUP BY 1, 2\n)\nSELECT\n  (date '2000-01-01' + (doy - 1))::timestamptz AS time,\n  yr::text AS metric,\n  sum(dist) OVER (PARTITION BY yr ORDER BY doy) AS \"Distance\"\nFROM daily\nORDER BY 1;",
          "refId": "A"
        }
      ],
      "title": "Cumulative Distance by Year ($length_unit)",
      "type": "timeseries"
    },
