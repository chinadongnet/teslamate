          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  TIMEZONE('$__timezone', TIMEZONE('UTC', start_date)) AS \"Fell Asleep\",\n  TIMEZONE('$__timezone', TIMEZONE('UTC', end_date)) AS \"Woke Up\",\n  date_part('epoch', end_date - start_date) / 3600.0 AS \"Hours\"\nFROM states\nWHERE car_id = $car_id AND $__timeFilter(start_date)\n  AND state = 'asleep' AND end_date IS NOT NULL\nORDER BY 3 DESC\nLIMIT 10;",
          "refId": "A"
        }
      ],
