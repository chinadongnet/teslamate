      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "TeslaMate"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH stays AS (\n  SELECT\n    d.end_address_id,\n    d.end_date,\n    pe.battery_level AS soc_end,\n    LEAD(d.start_date) OVER (ORDER BY d.start_date) AS next_start,\n    LEAD(ps.battery_level) OVER (ORDER BY d.start_date) AS soc_next\n  FROM drives d\n  JOIN positions pe ON d.end_position_id = pe.id\n  JOIN positions ps ON d.start_position_id = ps.id\n  WHERE d.car_id = $car_id AND d.end_date IS NOT NULL\n),\nclean AS (\n  SELECT\n    end_address_id,\n    soc_end - soc_next AS soc_drop,\n    date_part('epoch', next_start - end_date) / 86400.0 AS days\n  FROM stays\n  WHERE next_start IS NOT NULL\n    AND $__timeFilter(end_date)\n    AND date_part('epoch', next_start - end_date) >= 6 * 3600\n    AND soc_end IS NOT NULL AND soc_next IS NOT NULL\n    AND NOT EXISTS (\n      SELECT 1 FROM charging_processes cp\n      WHERE cp.car_id = $car_id\n        AND cp.start_date >= stays.end_date\n        AND cp.start_date < stays.next_start)\n)\nSELECT\n  COALESCE(a.name, a.display_name, 'Unknown') AS \"Location\",\n  a.latitude AS latitude,\n  a.longitude AS longitude,\n  count(*) AS \"Stays\",\n  sum(soc_drop) / NULLIF(sum(days), 0) AS \"SOC per Day\"\nFROM clean\nJOIN addresses a ON clean.end_address_id = a.id\nGROUP BY 1, 2, 3\nHAVING count(*) >= 2 AND sum(days) > 0.5;",
          "refId": "A"
        }
      ],
      "title": "Ø SOC Loss per Day While Parked (stays ≥ 6 h, no charging)",
      "type": "geomap"
