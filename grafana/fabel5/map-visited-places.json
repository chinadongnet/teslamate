          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  COALESCE(a.name, a.display_name, '?') AS \"Place\",\n  a.latitude AS latitude,\n  a.longitude AS longitude,\n  count(*) AS \"Visits\"\nFROM drives d\nJOIN addresses a ON d.end_address_id = a.id\nWHERE d.car_id = $car_id AND $__timeFilter(d.start_date)\n  AND d.end_date IS NOT NULL\nGROUP BY 1, 2, 3;",
          "refId": "A"
        }
      ],
