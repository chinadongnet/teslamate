      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "TeslaMate"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  TIMEZONE('$__timezone', TIMEZONE('UTC', start_date)) AS \"Start\",\n  COALESCE(sa.name, sa.display_name, '?') AS \"From\",\n  COALESCE(ea.name, ea.display_name, '?') AS \"To\",\n  convert_km(distance::numeric, '$length_unit') AS \"Distance\",\n  convert_m(ascent, '$alternative_length_unit') AS \"Ascent\",\n  convert_m(descent, '$alternative_length_unit') AS \"Descent\"\nFROM drives\nLEFT JOIN addresses sa ON drives.start_address_id = sa.id\nLEFT JOIN addresses ea ON drives.end_address_id = ea.id\nWHERE drives.car_id = $car_id AND $__timeFilter(start_date) AND end_date IS NOT NULL AND distance > 1 AND duration_min >= 2 AND ascent IS NOT NULL\nORDER BY ascent DESC\nLIMIT 10;",
          "refId": "A"
        }
      ],
      "title": "Top Climbing Drives",
      "type": "table"
    }
