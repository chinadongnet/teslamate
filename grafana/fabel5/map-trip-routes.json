          "rawQuery": true,
          "rawSql": "SELECT p.latitude, p.longitude\nFROM positions p\nWHERE p.drive_id = (\n    SELECT id FROM drives\n    WHERE car_id = $car_id AND $__timeFilter(start_date)\n      AND end_date IS NOT NULL\n    ORDER BY distance DESC NULLS LAST\n    OFFSET 0 LIMIT 1)\n  AND mod(p.id, 12) = 0\nORDER BY p.date;",
