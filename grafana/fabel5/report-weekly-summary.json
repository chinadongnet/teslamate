      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "TeslaMate"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH drive_stats AS (\n  SELECT\n    date_trunc('week', TIMEZONE('$__timezone', TIMEZONE('UTC', start_date))) AS wk,\n    count(*) AS drives,\n    sum(convert_km(distance::numeric, '$length_unit')) AS dist,\n    sum(duration_min) / 60.0 AS hours\n  FROM drives\n  WHERE car_id = $car_id AND $__timeFilter(start_date) AND end_date IS NOT NULL\n  GROUP BY 1\n),\ncharge_stats AS (\n  SELECT\n    date_trunc('week', TIMEZONE('$__timezone', TIMEZONE('UTC', start_date))) AS wk,\n    sum(charge_energy_added) AS added,\n    sum(cost) AS cost\n  FROM charging_processes\n  WHERE car_id = $car_id AND $__timeFilter(start_date) AND end_date IS NOT NULL\n  GROUP BY 1\n),\nweekly AS (\n  SELECT\n    COALESCE(d.wk, c.wk) AS wk,\n    d.drives, d.dist, d.hours, c.added, c.cost\n  FROM drive_stats d\n  FULL OUTER JOIN charge_stats c ON d.wk = c.wk\n)\nSELECT\n  to_char(wk, 'IYYY-\"W\"IW') AS \"Week\",\n  drives AS \"Drives\",\n  dist AS \"Distance\",\n  dist - lag(dist) OVER (ORDER BY wk) AS \"Δ Distance\",\n  hours AS \"Hours\",\n  added AS \"Energy Added\",\n  cost AS \"Cost\",\n  cost - lag(cost) OVER (ORDER BY wk) AS \"Δ Cost\"\nFROM weekly\nORDER BY wk DESC;",
          "refId": "A"
        }
      ],
      "title": "Weekly Summary with Week-over-Week Change",
      "type": "table"
    },
