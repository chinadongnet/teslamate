          "rawSql": "WITH per_drive AS (\n  SELECT DISTINCT ON (drive_id)\n    latitude, longitude,\n    convert_m(elevation, '$alternative_length_unit') AS \"Elevation\"\n  FROM positions\n  WHERE car_id = $car_id AND $__timeFilter(date)\n    AND drive_id IS NOT NULL AND elevation IS NOT NULL\n  ORDER BY drive_id, elevation ASC\n)\nSELECT * FROM per_drive\nORDER BY \"Elevation\" ASC\nLIMIT 50;",
