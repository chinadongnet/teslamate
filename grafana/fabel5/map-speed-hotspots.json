          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT latitude, longitude, speed\nFROM positions\nWHERE car_id = $car_id AND $__timeFilter(date)\n  AND speed >= 90 AND ideal_battery_range_km IS NOT NULL AND mod(id, 2) = 0;",
          "refId": "A"
