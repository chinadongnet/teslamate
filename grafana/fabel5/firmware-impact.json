      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "TeslaMate"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH versions AS (\n  SELECT\n    split_part(version, ' ', 1) AS version,\n    start_date,\n    COALESCE(LEAD(start_date) OVER (ORDER BY start_date),\n             TIMEZONE('UTC', now())) AS next_date\n  FROM updates\n  WHERE car_id = $car_id AND end_date IS NOT NULL AND version IS NOT NULL\n),\ndrive_versions AS (\n  SELECT\n    drives.id AS drive_id,\n    v.version,\n    v.start_date AS installed,\n    distance\n  FROM versions v\n  JOIN drives ON drives.start_date >= v.start_date\n             AND drives.start_date < v.next_date\n  WHERE drives.car_id = $car_id AND drives.end_date IS NOT NULL\n    AND distance > 1 AND duration_min >= 2\n),\npos AS (\n  SELECT\n    drive_id,\n    power,\n    is_climate_on,\n    extract(second FROM date - lag(date) OVER (PARTITION BY drive_id ORDER BY date)) AS seconds\n  FROM positions\n  WHERE car_id = $car_id AND drive_id IS NOT NULL\n),\ndrive_stats AS (\n  SELECT\n    drive_id,\n    sum(power * seconds / 3600.0) FILTER (WHERE power < 0 AND seconds < 1.5) * -1 AS regen_kwh,\n    avg(is_climate_on::int) >= 0.5 AS climate_on\n  FROM pos\n  WHERE seconds IS NOT NULL\n  GROUP BY drive_id\n),\nper_version AS (\n  SELECT\n    dv.version,\n    min(dv.installed) AS installed,\n    sum(convert_km(dv.distance::numeric, '$length_unit')) FILTER (WHERE ds.climate_on) AS dist_on,\n    sum(ds.regen_kwh) FILTER (WHERE ds.climate_on) AS regen_on,\n    sum(convert_km(dv.distance::numeric, '$length_unit')) FILTER (WHERE NOT ds.climate_on) AS dist_off,\n    sum(ds.regen_kwh) FILTER (WHERE NOT ds.climate_on) AS regen_off\n  FROM drive_versions dv\n  JOIN drive_stats ds ON ds.drive_id = dv.drive_id\n  GROUP BY 1\n)\nSELECT\n  version AS \"Version\",\n  100.0 * regen_on / NULLIF(dist_on, 0) AS \"Climate On\",\n  100.0 * regen_off / NULLIF(dist_off, 0) AS \"Climate Off\"\nFROM per_version\nWHERE COALESCE(dist_on, 0) + COALESCE(dist_off, 0) > 50\nORDER BY installed\n;",
          "refId": "A"
        }
      ],
      "title": "Ø Regen Recovered by Firmware Version, by Climate Use (kWh / 100 $length_unit)",
      "type": "barchart"
    }
