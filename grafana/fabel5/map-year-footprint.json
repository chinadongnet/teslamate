      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "TeslaMate"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH first_visits AS (\n  SELECT\n    end_address_id AS address_id,\n    min(start_date) AS first_date,\n    count(*) AS visits\n  FROM drives\n  WHERE car_id = $car_id AND end_address_id IS NOT NULL\n    AND end_date IS NOT NULL AND $__timeFilter(start_date)\n  GROUP BY 1\n)\nSELECT\n  COALESCE(a.name, a.display_name, '?') AS \"Place\",\n  a.latitude AS latitude,\n  a.longitude AS longitude,\n  fv.visits AS \"Visits\",\n  extract(year FROM TIMEZONE('$__timezone', TIMEZONE('UTC', fv.first_date)))::int AS \"Year\"\nFROM first_visits fv\nJOIN addresses a ON fv.address_id = a.id;",
          "refId": "A"
        }
      ],
      "title": "Destinations Colored by First Visit Year (blue = old, purple/red = recent)",
