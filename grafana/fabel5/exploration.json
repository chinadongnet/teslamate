          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH first_visits AS (\n  SELECT\n    end_address_id AS address_id,\n    min(start_date) AS first_date\n  FROM drives\n  WHERE car_id = $car_id AND end_address_id IS NOT NULL AND end_date IS NOT NULL\n  GROUP BY 1\n),\nmonthly AS (\n  SELECT\n    date_trunc('month', TIMEZONE('UTC', first_date), '$__timezone') AS mon,\n    count(*) AS new_places\n  FROM first_visits\n  GROUP BY 1\n)\nSELECT\n  mon AS time,\n  new_places AS \"New Places\",\n  sum(new_places) OVER (ORDER BY mon) AS \"Cumulative\"\nFROM monthly\nWHERE $__timeFilter(mon)\nORDER BY 1;",
          "refId": "A"
        }
      ],
      "title": "New Places per Month & Cumulative",
      "type": "timeseries"
    },
