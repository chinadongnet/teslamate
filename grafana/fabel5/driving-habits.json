          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  100.0 * count(*) FILTER (WHERE date_part('hour', TIMEZONE('$__timezone', TIMEZONE('UTC', start_date))) >= 22\n                              OR date_part('hour', TIMEZONE('$__timezone', TIMEZONE('UTC', start_date))) < 6)\n       / NULLIF(count(*), 0) AS \"Night Share\"\nFROM drives\nWHERE car_id = $car_id AND $__timeFilter(start_date) AND end_date IS NOT NULL;",
          "refId": "A"
        }
      ],
      "title": "Night Driving Share (22:00 – 06:00)",
      "type": "stat"
