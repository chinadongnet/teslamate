          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH first_visits AS (\n  SELECT\n    end_address_id AS address_id,\n    min(start_date) AS first_date\n  FROM drives\n  WHERE car_id = $car_id AND end_address_id IS NOT NULL AND end_date IS NOT NULL\n  GROUP BY 1\n)\nSELECT\n  COALESCE(a.name, a.display_name, '?') AS \"Place\",\n  a.latitude AS latitude,\n  a.longitude AS longitude,\n  date_part('epoch', TIMEZONE('UTC', now()) - fv.first_date) / 86400.0 AS \"Days Ago\"\nFROM first_visits fv\nJOIN addresses a ON fv.address_id = a.id\nWHERE $__timeFilter(fv.first_date);",
          "refId": "A"
        }
      ],
      "title": "Places First Visited in Period (color = how recent)",
      "type": "geomap"
