        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "TeslaMate"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH t AS (\n  SELECT s.state, sum(date_part('epoch', COALESCE(s.end_date, TIMEZONE('UTC', now())) - s.start_date)) AS sec\n  FROM states s\n  WHERE s.car_id = $car_id AND $__timeFilter(s.start_date)\n  GROUP BY 1\n)\nSELECT\n  100.0 * sum(sec) FILTER (WHERE state = 'online')  / NULLIF(sum(sec), 0) AS \"Online\",\n  100.0 * sum(sec) FILTER (WHERE state = 'asleep')  / NULLIF(sum(sec), 0) AS \"Asleep\",\n  100.0 * sum(sec) FILTER (WHERE state = 'offline') / NULLIF(sum(sec), 0) AS \"Offline\"\nFROM t;",
          "refId": "A"
        }
      ],
      "title": "Time by State",
      "type": "stat"
    },
