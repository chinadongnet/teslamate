          "rawQuery": true,
          "rawSql": "WITH parked AS (\n  SELECT\n    end_address_id,\n    end_date,\n    LEAD(start_date) OVER (ORDER BY start_date) AS next_start\n  FROM drives\n  WHERE car_id = $car_id AND end_date IS NOT NULL\n)\nSELECT\n  COALESCE(a.name, a.display_name, 'Unknown') AS \"Location\",\n  count(*) AS \"Stays\",\n  sum(date_part('epoch', next_start - end_date)) / 3600.0 AS \"Hours\"\nFROM parked\nJOIN addresses a ON parked.end_address_id = a.id\nWHERE next_start IS NOT NULL AND $__timeFilter(end_date)\nGROUP BY 1\nORDER BY 3 DESC\nLIMIT 8;",
          "refId": "A"
