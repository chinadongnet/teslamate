            "type": "grafana-postgresql-datasource",
            "uid": "TeslaMate"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH samples AS (\n  SELECT floor(battery_level / 5) * 5 AS soc\n  FROM positions\n  WHERE car_id = $car_id AND $__timeFilter(date)\n    AND ideal_battery_range_km IS NOT NULL AND battery_level IS NOT NULL\n)\nSELECT\n  soc::int AS \"SOC\",\n  100.0 * count(*) / sum(count(*)) OVER () AS \"Share\"\nFROM samples\nGROUP BY 1\nORDER BY 1;",
          "refId": "A"
        }
      ],
      "title": "Time at SOC (share of awake time)",
      "type": "barchart"
