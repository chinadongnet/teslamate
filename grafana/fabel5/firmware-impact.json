      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "TeslaMate"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH versions AS (\n  SELECT\n    split_part(version, ' ', 1) AS version,\n    start_date,\n    COALESCE(LEAD(start_date) OVER (ORDER BY start_date),\n             TIMEZONE('UTC', now())) AS next_date\n  FROM updates\n  WHERE car_id = $car_id AND end_date IS NOT NULL AND version IS NOT NULL\n),\nper_version AS (\n  SELECT\n    v.version,\n    min(v.start_date) AS installed,\n    sum((start_${preferred_range}_range_km - end_${preferred_range}_range_km) * cars.efficiency) AS energy,\n    sum(convert_km(distance::numeric, '$length_unit')) AS dist\n  FROM versions v\n  JOIN drives ON drives.start_date >= v.start_date\n             AND drives.start_date < v.next_date\n  INNER JOIN cars ON drives.car_id = cars.id\n  WHERE drives.car_id = $car_id AND drives.end_date IS NOT NULL\n    AND distance > 1 AND duration_min >= 2\n  GROUP BY 1\n)\nSELECT\n  version AS \"Version\",\n  100 * energy / NULLIF(dist, 0) AS \"Consumption\"\nFROM per_version\nWHERE dist > 50\nORDER BY installed\n;",
          "refId": "A"
        }
      ],
      "title": "Ø Consumption by Firmware Version (kWh / 100 $length_unit)",
      "type": "barchart"
