          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  trim(to_char(TIMEZONE('$__timezone', TIMEZONE('UTC', start_date)), 'Dy')) AS \"Day\",\n  sum(convert_km(distance::numeric, '$length_unit')) AS \"Distance\",\n  count(*) AS \"Drives\"\nFROM drives\nWHERE car_id = $car_id AND $__timeFilter(start_date) AND end_date IS NOT NULL\nGROUP BY 1, date_part('isodow', TIMEZONE('$__timezone', TIMEZONE('UTC', start_date)))\nORDER BY date_part('isodow', TIMEZONE('$__timezone', TIMEZONE('UTC', start_date)));",
          "refId": "A"
        }
      ],
      "title": "Distance by Day of Week ($length_unit)",
      "type": "barchart"
