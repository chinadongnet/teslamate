          "rawSql": "SELECT\n  count(*)::numeric / NULLIF(count(DISTINCT date_trunc('day',\n    TIMEZONE('$__timezone', TIMEZONE('UTC', start_date)))), 0) AS \"Wake-ups\"\nFROM states\nWHERE car_id = $car_id AND $__timeFilter(start_date) AND state = 'online';",
