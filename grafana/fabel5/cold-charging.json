          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH sessions AS (\n  SELECT\n    cp.id,\n    cp.start_date,\n    cp.address_id,\n    cp.charge_energy_added,\n    cp.duration_min,\n    avg(c.outside_temp) AS temp,\n    max(c.charger_power) AS max_power,\n    bool_or(c.battery_heater_on) AS heater,\n    CASE WHEN NULLIF(mode() WITHIN GROUP (ORDER BY c.charger_phases), 0) IS NULL\n         THEN 'DC' ELSE 'AC' END AS current\n  FROM charging_processes cp\n  JOIN charges c ON cp.id = c.charging_process_id\n  WHERE cp.car_id = $car_id\n    AND $__timeFilter(cp.start_date)\n    AND cp.end_date IS NOT NULL\n    AND cp.charge_energy_added > 0.1\n  GROUP BY 1\n)\nSELECT\n  TIMEZONE('$__timezone', TIMEZONE('UTC', sessions.start_date)) AS \"Start\",\n  COALESCE(a.name, a.display_name, 'Unknown') AS \"Location\",\n  sessions.current AS \"Type\",\n  temp AS \"Ø Temp [°C]\",\n  heater AS \"Heater\",\n  charge_energy_added AS \"Added\",\n  max_power AS \"Peak Power\",\n  duration_min AS \"Duration\"\nFROM sessions\nLEFT JOIN addresses a ON sessions.address_id = a.id\nWHERE temp IS NOT NULL\nORDER BY temp ASC\nLIMIT 10;",
          "refId": "A"
        }
      ],
      "title": "Coldest Charging Sessions",
