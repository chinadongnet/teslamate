          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH parked AS (\n  SELECT\n    end_address_id,\n    end_date,\n    LEAD(start_date) OVER (ORDER BY start_date) AS next_start\n  FROM drives\n  WHERE car_id = $car_id AND end_date IS NOT NULL\n)\nSELECT avg(date_part('epoch', next_start - end_date)) / 3600.0 AS \"Ø Stay\"\nFROM parked\nWHERE next_start IS NOT NULL AND $__timeFilter(end_date);",
          "refId": "A"
        }
      ],
      "title": "Ø Stay Duration",
      "type": "stat"
