          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  to_char(date_trunc('month', TIMEZONE('$__timezone', TIMEZONE('UTC', start_date))), 'YYYY-MM') AS \"Month\",\n  convert_m(sum(ascent), '$alternative_length_unit') AS \"Ascent\",\n  -convert_m(sum(descent), '$alternative_length_unit') AS \"Descent\"\nFROM drives\nWHERE car_id = $car_id AND $__timeFilter(start_date) AND end_date IS NOT NULL\nGROUP BY 1\nORDER BY 1;",
          "refId": "A"
        }
      ],
      "title": "Monthly Ascent & Descent ($alternative_length_unit)",
      "type": "barchart"
