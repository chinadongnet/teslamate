          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH sessions AS (\n  SELECT\n    cp.id,\n    cp.start_date,\n    cp.charge_energy_added,\n    cp.charge_energy_used,\n    cp.address_id,\n    cp.duration_min,\n    CASE WHEN NULLIF(mode() WITHIN GROUP (ORDER BY charger_phases), 0) IS NULL\n         THEN 'DC' ELSE 'AC' END AS current,\n    max(charger_power) AS max_power\n  FROM charging_processes cp\n  JOIN charges ON cp.id = charges.charging_process_id\n  WHERE cp.car_id = $car_id\n    AND $__timeFilter(cp.start_date)\n    AND cp.end_date IS NOT NULL\n    AND cp.charge_energy_added > 0.1\n    AND cp.charge_energy_used > 0.1\n  GROUP BY 1\n)\nSELECT\n  TIMEZONE('$__timezone', TIMEZONE('UTC', sessions.start_date)) AS \"Start\",\n  COALESCE(a.name, a.display_name, 'Unknown') AS \"Location\",\n  sessions.current AS \"Type\",\n  charge_energy_added AS \"Added\",\n  charge_energy_used AS \"Used\",\n  charge_energy_used - charge_energy_added AS \"Lost\",\n  100.0 * charge_energy_added / NULLIF(charge_energy_used, 0) AS \"Efficiency\"\nFROM sessions\nLEFT JOIN addresses a ON sessions.address_id = a.id\nWHERE duration_min >= 10\nORDER BY 6 DESC\nLIMIT 10;",
          "refId": "A"
        }
      ],
      "title": "Highest-Loss Sessions",
      "type": "table"
