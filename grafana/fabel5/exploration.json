          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH first_visits AS (\n  SELECT\n    end_address_id AS address_id,\n    min(start_date) AS first_date\n  FROM drives\n  WHERE car_id = $car_id AND end_address_id IS NOT NULL AND end_date IS NOT NULL\n  GROUP BY 1\n)\nSELECT\n  TIMEZONE('$__timezone', TIMEZONE('UTC', fv.first_date)) AS \"First Visit\",\n  COALESCE(a.name, a.display_name, '?') AS \"Place\",\n  a.city AS \"City\",\n  a.state AS \"State\"\nFROM first_visits fv\nJOIN addresses a ON fv.address_id = a.id\nWHERE $__timeFilter(fv.first_date)\nORDER BY fv.first_date DESC\nLIMIT 15;",
          "refId": "A"
        }
      ],
      "title": "Recently Discovered Places",
      "type": "table"
